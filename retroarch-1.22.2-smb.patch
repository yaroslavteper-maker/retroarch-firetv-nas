+#ifdef HAVE_SMB
+/* Content on an smb:// share is copied to a local cache before loading,
+ * so every core (including ones that open files themselves) can use it.
+ * The content list entry is replaced by the local path; RARCH_PATH_CONTENT
+ * keeps the smb:// path, so history, playlists and save names are unchanged. */
+static bool content_file_fetch_smb(struct string_list *content,
+      size_t idx, char **err_string)
+{
+   char cache_dir[PATH_MAX_LENGTH];
+   char local[PATH_MAX_LENGTH];
+   char err[1024];
+   settings_t *settings = config_get_ptr();
+   const char *base     = settings ? settings->paths.directory_cache : NULL;
+
+   if (string_is_empty(base))
+      base = g_defaults.dirs[DEFAULT_DIR_CACHE];
+   if (string_is_empty(base))
+   {
+      *err_string = strdup("No cache directory set for network content.");
+      return false;
+   }
+   fill_pathname_join_special(cache_dir, base, "smb_cache", sizeof(cache_dir));
+
+   RARCH_LOG("[Content] Fetching from network share: \"%s\".\n",
+         content->elems[idx].data);
+   if (!retro_vfs_smb_cache_fetch(content->elems[idx].data, cache_dir,
+            retro_vfs_smb_cache_limit(), local, sizeof(local),
+            err, sizeof(err)))
+   {
+      RARCH_ERR("[Content] %s\n", err);
+      *err_string = strdup(err);
+      return false;
+   }
+   RARCH_LOG("[Content] Using cached copy: \"%s\".\n", local);
+
+   free(content->elems[idx].data);
+   content->elems[idx].data = strdup(local);
+   return content->elems[idx].data != NULL;
+}
+#endif
